# Settings for sms_forward.py.
#
# Copy this file to <SMS_HOME>/sms_forward.env (default: ~/.myna-call/sms/sms_forward.env)
# and remove the "#" in front of what you want to change. Every line is optional.
# A variable that is already set in the environment wins over this file.
# SMS_HOME and SMS_ENV_FILE themselves can only be set in the environment.
# Keep the file private: it may hold the agent's token.

# Where the Myna agent listens.
#AGENT_URL=http://127.0.0.1:8787

# The agent's CALLS_UI_TOKEN, when it has one. Sent as "Authorization: Bearer <token>".
#AGENT_TOKEN=

# Language of the labels in the forwarded message:
# en, zh-TW, zh-CN, ja, ko, es, fr, de, pt. Empty = the agent's language, else English.
#SMS_LANG=en

# Full path of adb. Set it when more than one adb is installed, to the one the agent uses.
#ADB_BIN=/path/to/platform-tools/adb

# Only these phones (serials as shown by "adb devices", comma separated). Empty = all.
#SMS_SERIALS=TESTSERIAL0001,TESTSERIAL0002

# Label for a SIM card that does not report its own number: ICCID=label, comma separated.
#SMS_SIM_NUMBERS=8900000000000000010=+15555550100

# 0 = never run "su" on the phone (no hook queue; the inbox is read as the shell user only).
#SMS_USE_SU=1

# Seconds between checks of the hook queue, and between inbox polls.
#SMS_PUSH_SEC=4
#SMS_INBOX_SEC=60

# The same text from the same sender on the same phone is sent once within this many seconds.
#SMS_DEDUP_SEC=86400

# More new inbox messages than this at once are skipped (one notice is sent instead).
#SMS_FLOOD_CAP=20
