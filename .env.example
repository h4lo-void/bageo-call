# Bageo - optional settings read at start-up.
# Copy this file to ".env" and remove the "#" in front of what you want to change.
# Everyday settings (API key, language, voice, notifications, ...) are NOT here:
# set those in the web console, they are saved under the data folder.

# --- Where the agent listens -------------------------------------------------
# Not set (default): the web console listens on your network at AGENT_PORT and,
# when it can, at port 80 too, so http://bageo.local/ opens it on this computer
# and on the phones and computers of the same Wi-Fi. Other devices get in only
# once a console password is set. Phones keep their own Wi-Fi port below.
# AGENT_HOST=127.0.0.1: this computer only. AGENT_HOST=0.0.0.0: everything open
# to the network (then ALSO set both tokens below).
#AGENT_HOST=127.0.0.1
#AGENT_PORT=8787
# Port 80 for the console while AGENT_HOST is not set; off = only AGENT_PORT.
#CONSOLE_PORT_80=off
# Phones plugged in by USB once get a pairing key and then connect over Wi-Fi
# on this port (AGENT_PORT + 1 when unset; 0 = never). Only while AGENT_HOST
# is not set or 127.0.0.1; the console setting "Phones can also connect over Wi-Fi" turns it off.
#PHONE_WIFI_PORT=8788

# Password for the web console and its API (send as ?token=... or
# "Authorization: Bearer ..."). Other devices need it while AGENT_HOST is not
# set; leave it empty only when only this computer uses the console.
#CALLS_UI_TOKEN=

# Phones that connect over Wi-Fi must use ws://<this-pc>:8787/ws?token=<this>.
# Phones on USB do not need it.
#DEVICE_TOKEN=

# Address of the web console as you reach it, for links in notifications.
# Empty: http://<MDNS_NAME>.local/ (http://<MDNS_NAME>.local:8787 without port
# 80, or this computer's network address) unless AGENT_HOST=127.0.0.1; in
# Docker set it yourself. The console's "Address in notifications" wins.
#PUBLIC_URL=http://192.168.1.20:8787

# Name on your network: phones and computers on the same network open the
# web console at http://bageo.local/ (when this
# computer lets the agent answer the name). off, 0, none or false = off
# (write "off": on Windows an empty value counts as not set).
# On a VPN that sends all traffic through the tunnel, set AGENT_HOST to this
# computer's LAN IP (e.g. 192.168.1.20) so the name and links use it.
#MDNS_NAME=bageo

# --- Start script -------------------------------------------------------------
# 1 = do not put the "Bageo Console" shortcut to the web console on the desktop.
#BAGEO_NO_SHORTCUT=1

# --- Data ---------------------------------------------------------------------
# Call records, recordings and settings. Default: ./data/calls
#CALLS_DATA_DIR=
# Default for the days records are kept (calls and recordings, texts, AI
# errands, to-do items), 1-365; change it in the console under Advanced.
#CALLS_RETENTION_DAYS=15

# --- Phones on USB ------------------------------------------------------------
# The agent keeps "adb reverse" up and starts the phone app by itself.
# off = you do that yourself (phones on Wi-Fi, or another computer has the phones).
#USB_BRIDGE=on
# Full path to adb when several are installed (mixing adb versions drops phones).
#ADB_BIN=
# Only these phones (serials from "adb devices", comma separated). Default: all.
#ADB_SERIALS=

# --- First-run defaults (the web console overrides them) ----------------------
#GEMINI_API_KEY=
#APP_LANGUAGE=en
#OWNER_NAME=
#OWNER_ALIASES=
#ANSWER_STYLE=assistant

# --- Logging ------------------------------------------------------------------
#RUST_LOG=agent=info
# Put what callers and the AI say into the log (default off: only character counts).
# Turn on only while troubleshooting.
#LOG_CALL_TEXT=1
