    <!-- Notifications -->
    <string name="notification_title">Myna</string>
    <string name="notification_text_armed">대기 중입니다. 전화를 기다리고 있으며 휴대전화는 무음 상태를 유지합니다.</string>
    <string name="notification_text_in_call">AI가 통화를 처리하고 있습니다.</string>
    <string name="notification_text_disabled">AI 응답이 일시중지되었습니다.</string>
    <string name="uplink_missing_title">상대방이 AI 음성을 들을 수 없습니다</string>
    <string name="uplink_missing_text">통화 오디오 경로를 사용할 수 없습니다. Myna 모듈이 설치되고 사용 설정되어 있는지 확인한 후 다시 시작하세요.</string>

