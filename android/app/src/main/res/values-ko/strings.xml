    <string name="check_priv_ok">설치 위치: %1$s</string>
    <string name="check_priv_missing">일반 앱으로 설치되어 있습니다(%1$s). Magisk 또는 KernelSU에서 Myna 모듈을 설치하고 다시 시작하세요. APK를 직접 설치한 적이 있다면 그 앱은 제거하세요.</string>

    <string name="check_privperm_title">시스템 전용 권한</string>
