    <string name="check_uplink_idle">지금은 보이지 않습니다. 일부 기기에서는 통화 중에만 나타납니다. 주입에 실패하면 앱이 알려 줍니다.</string>
    <string name="check_uplink_missing">모듈이 필요합니다. MODIFY_PHONE_STATE 권한이 없습니다.</string>

    <!-- Connection -->
    <string name="section_connection">연결</string>
    <string name="agent_url_label">에이전트 주소</string>
    <string name="connection_hint_usb">USB(기본값, 권장): ws://127.0.0.1:8765를 그대로 두세요. PC 프로그램이 adb reverse로 이 포트를 USB 케이블을 통해 자동으로 전달합니다.</string>
    <string name="connection_hint_wifi">Wi-Fi: PC 프로그램에 표시된 주소를 입력하세요(예: ws://192.0.2.10:8787/ws?token=…). 휴대전화와 PC가 같은 네트워크에 있어야 합니다.</string>
    <string name="btn_save">저장</string>
    <string name="btn_reset_usb">USB 기본값으로 재설정</string>
    <string name="btn_test">연결 테스트</string>
    <string name="msg_url_invalid">주소는 ws:// 또는 wss://로 시작하고 호스트를 포함해야 합니다.</string>
    <string name="msg_url_saved">저장했습니다.</string>
    <string name="msg_url_saved_restarted">저장했습니다. 새 주소를 사용하도록 서비스를 다시 시작했습니다.</string>
    <string name="msg_url_saved_pending">저장했습니다. 새 주소를 사용하려면 통화 중이 아닐 때 \'서비스 중지\'를 탭한 다음 \'서비스 시작\'을 탭하세요.</string>
    <string name="test_running">연결 중…</string>
    <string name="test_ok">연결됨</string>
    <string name="test_failed">실패: %1$s</string>
    <string name="test_timeout">5초 안에 응답이 없습니다</string>
    <string name="test_closed">연결이 종료되었습니다(코드 %1$d)</string>

    <!-- About and safety -->
    <string name="section_about">정보 및 안전</string>
    <string name="about_dedicated">전용 휴대전화를 사용하세요. 모듈이 전화 앱을 대신하고 벨소리를 끄며 방해 금지 모드를 켜므로, 일반 휴대전화로는 더 이상 사용할 수 없습니다.</string>
    <string name="about_rollback">일반 휴대전화로 되돌리려면 Magisk 또는 KernelSU에서 모듈을 사용 중지하거나 삭제한 다음 다시 시작하세요. 그 후에도 Google 전화 앱이나 벨소리가 꺼져 있으면 README의 복구 절차를 따르세요.</string>
    <string name="about_legal">통화 녹음과, 상대방에게 AI와 통화 중임을 알려야 하는지에 관한 법률은 국가와 지역마다 다릅니다. 법규 준수는 사용자의 책임입니다.</string>
</resources>
