<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ocRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/ocBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_badge_accent"
        android:paddingStart="14dp"
        android:paddingTop="5dp"
        android:paddingEnd="14dp"
        android:paddingBottom="5dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/bg_on_accent_soft"
        android:textSize="14sp" />

    <FrameLayout
        android:id="@+id/ocAvatarWrap"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_avatar_circle">

        <TextView
            android:id="@+id/ocAvatarText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/bg_on_accent_soft"
            android:textSize="32sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/ocTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/bg_text"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/ocSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@color/bg_muted"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/ocReasonCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/ocReasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/bg_text"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:id="@+id/ocTopSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Mode 1: Whitelist Direct Incoming -->
    <LinearLayout
        android:id="@+id/ocPanelIncomingWhitelist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/ocBtnWlAnswer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_accent"
            android:stateListAnimator="@null"
            android:text="@string/sa_btn_answer"
            android:textAllCaps="false"
            android:textColor="@color/bg_on_accent"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/ocBtnWlHandAi"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_secondary"
            android:stateListAnimator="@null"
            android:text="@string/sa_btn_hand_ai"
            android:textAllCaps="false"
            android:textColor="@color/bg_on_secondary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/ocBtnWlReject"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_danger"
            android:stateListAnimator="@null"
            android:text="@string/sa_btn_hangup"
            android:textAllCaps="false"
            android:textColor="@color/bg_on_bad"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Mode 2: Urgent AI Prompt Takeover -->
    <LinearLayout
        android:id="@+id/ocPanelUrgentPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/ocBtnUrgentTake"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_accent"
            android:stateListAnimator="@null"
            android:text="@string/sa_btn_takeover_now"
            android:textAllCaps="false"
            android:textColor="@color/bg_on_accent"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/ocBtnUrgentDecline"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_secondary"
            android:stateListAnimator="@null"
            android:text="@string/sa_btn_let_ai_handle"
            android:textAllCaps="false"
            android:textColor="@color/bg_on_secondary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Mode 3: Owner In-Call -->
    <LinearLayout
        android:id="@+id/ocPanelInCall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <GridLayout
            android:id="@+id/ocDtmfGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:columnCount="3"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ocBtnSpeaker"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:stateListAnimator="@null"
                android:text="@string/sa_btn_speaker_off"
                android:textAllCaps="false"
                android:textColor="@color/bg_on_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/ocBtnMute"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:stateListAnimator="@null"
                android:text="@string/sa_btn_mute"
                android:textAllCaps="false"
                android:textColor="@color/bg_on_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/ocBtnKeypad"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:stateListAnimator="@null"
                android:text="@string/sa_btn_keypad"
                android:textAllCaps="false"
                android:textColor="@color/bg_on_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <Button
            android:id="@+id/ocBtnInCallHangup"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_danger"
            android:stateListAnimator="@null"
            android:text="@string/sa_btn_hangup"
            android:textAllCaps="false"
            android:textColor="@color/bg_on_bad"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Mode 4: Standalone Dialer -->
    <LinearLayout
        android:id="@+id/ocPanelDialer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/ocDialInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_card"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:hint="@string/sa_dial_hint"
            android:inputType="phone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/bg_text"
            android:textColorHint="@color/bg_muted"
            android:textSize="26sp" />

        <LinearLayout
            android:id="@+id/ocSimRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone" />

        <GridLayout
            android:id="@+id/ocDialGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ocBtnDialClose"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="0.9"
                android:background="@drawable/bg_btn_secondary"
                android:stateListAnimator="@null"
                android:text="@string/sa_btn_close"
                android:textAllCaps="false"
                android:textColor="@color/bg_on_secondary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/ocBtnDialPlace"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1.5"
                android:background="@drawable/bg_btn_accent"
                android:stateListAnimator="@null"
                android:text="@string/sa_btn_dial"
                android:textAllCaps="false"
                android:textColor="@color/bg_on_accent"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/ocBtnDialBack"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="0.9"
                android:background="@drawable/bg_btn_secondary"
                android:stateListAnimator="@null"
                android:text="@string/sa_btn_backspace"
                android:textAllCaps="false"
                android:textColor="@color/bg_on_secondary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
