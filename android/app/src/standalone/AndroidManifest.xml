<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <application>
        <activity
            android:name=".OwnerCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showOnLockScreen="true" />

        <service
            android:name=".BageoModeTileService"
            android:exported="true"
            android:icon="@android:drawable/stat_sys_phone_call"
            android:label="@string/sa_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".DndStatusReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.app.action.INTERRUPTION_FILTER_CHANGED" />
                <action android:name="android.app.action.AUTOMATIC_ZEN_RULE_STATUS_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".SmsBroadcastReceiver"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
