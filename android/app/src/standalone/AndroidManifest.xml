<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Whitelist and urgent calls open the call screen over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application>
        <meta-data android:name="xposedmodule" tools:node="remove" />
        <meta-data android:name="xposeddescription" tools:node="remove" />
        <meta-data android:name="xposedminversion" tools:node="remove" />
        <meta-data android:name="xposedscope" tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="false"
            android:windowSoftInputMode="adjustResize"
            tools:replace="android:excludeFromRecents" />

        <activity
            android:name=".OwnerCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showOnLockScreen="true" />

        <!--
          Android's after-call request to the phone app (POST_CALL): taken and closed
          without a screen. Off by default; Bageo turns it on only in AI mode.
        -->
        <activity
            android:name=".PostCallActivity"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.telecom.action.POST_CALL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Sets up Bageo's own mode when the app's process starts; serves no data. -->
        <provider
            android:name=".BageoModesInit"
            android:authorities="${applicationId}.bageo-modes"
            android:directBootAware="true"
            android:exported="false" />

        <service
            android:name=".BageoModeTileService"
            android:exported="true"
            android:icon="@android:drawable/stat_sys_phone_call"
            android:label="@string/sa_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".DndStatusReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.app.action.INTERRUPTION_FILTER_CHANGED" />
                <action android:name="android.app.action.AUTOMATIC_ZEN_RULE_STATUS_CHANGED" />
                <action android:name="android.app.action.NOTIFICATION_POLICY_ACCESS_GRANTED_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
